{
    "$schema": "node_modules/wrangler/config-schema.json",
    "main": "worker.js",
    "name": "sportzpoint-frontend",
    "compatibility_date": "2026-06-10",
    "compatibility_flags": [
        "nodejs_compat",
        "global_fetch_strictly_public"
    ],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS"
    }
}